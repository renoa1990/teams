datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model user {
  id       Int    @id @default(autoincrement())
  userId   String @unique
  password String
  level    String
}

model total {
  id             Int        @id @default(autoincrement())
  totalAt        DateTime
  createAt       DateTime
  site           String
  yesterDayTotal Int
  todayTotal     Int
  solutionTotal  Int
  userHoldings   Int      @default(0)
  marginTotla    Int
  withdraw       withdraw[]
  deposit        deposit[]
  balance        balance[]
  lockedBalance  lockedBalance[]
  confirm        Boolean    @default(false)
}

model withdraw {
  id      Int    @id @default(autoincrement())
  memo    String @default("")
  price   Int
  total   total? @relation(fields: [totalId], references: [id])
  totalId Int?

  @@index([totalId])
}

model deposit {
  id      Int    @id @default(autoincrement())
  memo    String @default("")
  price   Int
  total   total? @relation(fields: [totalId], references: [id])
  totalId Int?

  @@index([totalId])
}

model balance {
  id      Int    @id @default(autoincrement())
  memo    String @default("")
  price   Int
  total   total? @relation(fields: [totalId], references: [id])
  totalId Int?

  @@index([totalId])
}

model lockedBalance {
  id      Int    @id @default(autoincrement())
  memo    String @default("")
  price   Int
  total   total? @relation(fields: [totalId], references: [id])
  totalId Int?

  @@index([totalId])
}
